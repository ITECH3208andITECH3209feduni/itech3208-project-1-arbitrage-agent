{
  "compilerOptions": {
    "allowJs": false,
    "strict": true,
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "ESNext",
    "target": "ESNext",
    "lib": ["ES2021", "dom"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["./**/*.ts", "./**/*.tsx"],
  "exclude": ["./_generated", "./**/*.js"]
}
